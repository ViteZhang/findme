# Supabase 客户端配置（前端可读）
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Supabase 服务端高权限密钥（仅服务端使用，切勿暴露给前端）
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini API 配置（建议使用 Paid Tier 以确保数据不用于模型训练）
GEMINI_API_KEY=
GEMINI_SAFETY_MODEL=gemini-2.5-flash-lite
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_PORTRAIT_MODEL=gemini-3.1-pro-preview

# 敏感字段应用层加密密钥（64位十六进制字符串，用于 AES-256-GCM 加密故事与原话）
DATA_ENCRYPTION_KEY=

# 允许登录的个人邮箱白名单（多个用英文逗号分隔；留空则不额外限制）
ALLOWED_USER_EMAILS=
